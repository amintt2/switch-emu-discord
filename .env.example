# Serveur Switch EMU (variables à mettre dans Coolify)

# Application Discord (portail développeur > OAuth2)
DISCORD_CLIENT_ID=1562101845688717364
DISCORD_CLIENT_SECRET=

# Secrets aléatoires (ex. : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
SESSION_SECRET=
AGENT_SECRET=
# Doit être identique au secret du relais Cloudflare : cd relais && npx wrangler secret put RELAY_SECRET
RELAY_SECRET=

# Adresse publique du serveur (pour le relais de repli)
PUBLIC_URL=https://switch.mciut.fr
# Relais Cloudflare (off = désactivé) et chemin mappé dans Discord (URL Mappings : /cf -> le Worker)
RELAIS_CF_URL=wss://switch-emu-relais.amin2020e.workers.dev/relais
RELAIS_CF_CHEMIN=/cf/relais

# Essais sans Discord : http://localhost:3000/?salle=test&nom=Alice
ALLOW_BROWSER_MODE=0
